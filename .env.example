# Application Settings
PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Database Configuration
DATABASE_URL=jdbc:postgresql://localhost:5432/clinicsaas
DATABASE_USERNAME=root
DATABASE_PASSWORD=password

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT Security
JWT_SECRET=super-secret-key-that-is-at-least-256-bits-long-change-this-in-production
JWT_EXPIRATION_MS=86400000

# AWS S3 / Cloudflare R2 Configuration
S3_ENDPOINT=https://s3.amazonaws.com
S3_REGION=ap-south-1
S3_BUCKET_NAME=clinic-saas-pdf-storage
S3_ACCESS_KEY=your-s3-access-key
S3_SECRET_KEY=your-s3-secret-key

# Meta WhatsApp Cloud API Configuration
WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-number-id
WHATSAPP_API_TOKEN=your-whatsapp-api-token
WHATSAPP_TEMPLATE_NAME=invoice_delivery_template
