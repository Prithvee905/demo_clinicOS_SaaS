	"item": [
		{
			"name": "1. Auth Module",
			"item": [
				{
					"name": "1.1 Register Clinic & Admin",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"var ts = Date.now();",
									"pm.collectionVariables.set('clinicCode', 'clinic-' + ts);",
									"pm.collectionVariables.set('adminEmail', 'admin-' + ts + '@clinic.com');"
								],
								"type": "text/javascript"
							}
						},
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status code is 201 Created', function () {",
									"    pm.response.to.have.status(201);",
									"});",
									"var regData = pm.response.json();",
									"pm.test('Tokens issued successfully', function () {",
									"    pm.expect(regData.accessToken).to.not.be.empty;",
									"    pm.expect(regData.refreshToken).to.not.be.empty;",
									"});",
									"pm.collectionVariables.set('accessToken', regData.accessToken);",
									"pm.collectionVariables.set('refreshToken', regData.refreshToken);"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"clinicName\": \"Sunrise Dental Care\",\n  \"clinicCode\": \"{{clinicCode}}\",\n  \"ownerName\": \"Dr. Sunrise\",\n  \"clinicPhone\": \"+91-9876543210\",\n  \"clinicEmail\": \"contact@{{clinicCode}}.com\",\n  \"clinicAddress\": \"123 Health Ave, Bangalore\",\n  \"adminEmail\": \"{{adminEmail}}\",\n  \"adminName\": \"Admin User\",\n  \"adminPhone\": \"+91-9876543211\",\n  \"password\": \"{{adminPassword}}\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/register",
							"host": ["{{baseUrl}}"],
							"path": ["auth", "register"]
						}
					}
				},
				{
					"name": "1.2 Login Admin",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status code is 200 OK', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"var loginData = pm.response.json();",
									"pm.test('Role is ADMIN', function () {",
									"    pm.expect(loginData.role).to.eql('ADMIN');",
									"});",
									"pm.collectionVariables.set('accessToken', loginData.accessToken);"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\",\n  \"clinicCode\": \"{{clinicCode}}\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/login",
							"host": ["{{baseUrl}}"],
							"path": ["auth", "login"]
						}
					}
				}
			]
		},
